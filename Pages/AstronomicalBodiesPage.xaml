<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Astronomy.Pages.AstronomicalBodiesPage"
             Title="Astronomical Bodies">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="🌌 Select a celestial body:" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

        <Button x:Name="btnSun" Text="☀️ Sun" />
        <Button x:Name="btnMoon" Text="🌙 Moon" />
        <Button x:Name="btnEarth" Text="🌍 Earth" />
        <Button x:Name="btnComet" Text="☄️ Halley's Comet" />

        <Label Text="Tip: Click on any body to see details." FontSize="16" HorizontalOptions="Center" Margin="0,20,0,0" />
    </VerticalStackLayout>
</ContentPage>