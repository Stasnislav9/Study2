<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Astronomy.Pages.AboutPage"
             Title="About">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="ℹ️ About Astronomy App" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="This app provides information about astronomical phenomena." FontSize="18" />
        <Label Text="Features:" FontSize="18" FontAttributes="Bold" />
