<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Astronomy.Pages.AstronomicalBodyPage"
             Title="Celestial Body">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label x:Name="lblTitle" Text="Body Details" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
        <Image x:Name="imgBody" HeightRequest="200" WidthRequest="200" HorizontalOptions="Center" />
        <Label x:Name="lblDescription" Text="" FontSize="18" />
    </VerticalStackLayout>
</ContentPage>