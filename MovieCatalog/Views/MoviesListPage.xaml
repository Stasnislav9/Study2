<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MovieCatalog.ViewModels"
             x:Class="MovieCatalog.Views.MoviesListPage"
             Title="Movie Catalog">

	<Grid>
		<CollectionView ItemsSource="{Binding Movies}"
                        SelectedItem="{Binding SelectedMovie, Mode=OneWayToSource}"
                        SelectionMode="Single"
                        Margin="10"
                        SelectionChanged="OnSelectionChanged">

			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="vm:MovieViewModel">
					<Grid ColumnDefinitions="*, Auto" Padding="10" RowSpacing="5">
						<VerticalStackLayout Grid.Column="0">
							<Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold"/>
							<Label Text="{Binding Genre}" FontSize="14" TextColor="Gray"/>
							<Label Text="{Binding Year}" FontSize="12"/>
						</VerticalStackLayout>

						<Button Grid.Column="1"
                                Text="Delete"
                                BackgroundColor="Red"
                                TextColor="White"
                                VerticalOptions="Center"
                                Clicked="OnDeleteButtonClicked"/>
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<ActivityIndicator IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
	</Grid>

</ContentPage>