<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MovieCatalog.ViewModels"
             xmlns:local="clr-namespace:MovieCatalog"
             x:Class="MovieCatalog.Views.MovieDetailPage"
             Title="Movie Details">

	<ContentPage.BindingContext>
		<Binding Source="{x:Static local:App.MainViewModel}" Path="SelectedMovie" />
	</ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="{Binding Title}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Text="{Binding Genre}" FontSize="16" HorizontalOptions="Center"/>
            <Label Text="{Binding Year}" FontSize="14" HorizontalOptions="Center"/>
            <Label Text="Director:" FontSize="14" FontAttributes="Bold"/>
            <Label Text="{Binding Director}" FontSize="14"/>
            <Label Text="Description:" FontSize="14" FontAttributes="Bold"/>
            <Label Text="{Binding Description}" FontSize="14"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>